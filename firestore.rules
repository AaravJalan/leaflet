rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function orgDoc(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)).data;
    }

    function isOrgOwner(orgId) {
      return signedIn()
        && exists(/databases/$(database)/documents/organizations/$(orgId))
        && orgDoc(orgId).ownerId == request.auth.uid;
    }

    function isOrgPoster(orgId) {
      return isOrgOwner(orgId)
        || (
          signedIn()
          && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid))
        );
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId);
    }

    match /organizations/{orgId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.slug is string
        && request.resource.data.description is string
        && request.resource.data.type is string
        && request.resource.data.ownerName is string
        && request.resource.data.createdAt is number
        && request.resource.data.verified is bool;
      allow update, delete: if isOrgOwner(orgId);

      match /members/{memberId} {
        allow read: if true;
        allow create, update, delete: if isOrgOwner(orgId)
          || (
            // Owner bootstraps their own membership when creating the org
            signedIn()
            && isOrgOwner(orgId)
          )
          || (
            // Allow creator to write their owner membership in the same session
            signedIn()
            && memberId == request.auth.uid
            && request.resource.data.role == 'owner'
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.orgId == orgId
            && exists(/databases/$(database)/documents/organizations/$(orgId))
            && orgDoc(orgId).ownerId == request.auth.uid
          );
      }
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isOrgPoster(request.resource.data.orgId);
      allow update, delete: if signedIn()
        && (
          resource.data.createdBy == request.auth.uid
          || isOrgOwner(resource.data.orgId)
        );
    }

    match /subscriptions/{subscriptionId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == subscriptionId;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
