rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function accountType() {
      return userData().accountType;
    }

    function canOrganize() {
      return signedIn()
        && (accountType() == 'organizer' || accountType() == 'both');
    }

    function canVolunteer() {
      return signedIn()
        && (accountType() == 'volunteer' || accountType() == 'both');
    }

    function orgData(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)).data;
    }

    function isOrgOwner(orgId) {
      return signedIn() && orgData(orgId).ownerId == request.auth.uid;
    }

    function isPoster(orgId) {
      return isOrgOwner(orgId)
        || exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == userId;

      match /activity/{eventId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.targetUserId == userId
          && request.resource.data.type in ['allowed', 'removed'];
      }
    }

    match /organizations/{orgId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.createdAt is number;
      allow update, delete: if isOrgOwner(orgId);

      match /members/{memberId} {
        allow read: if true;
        allow create, update: if isOrgOwner(orgId)
          && request.resource.data.userId == memberId
          && request.resource.data.orgId == orgId;
        allow delete: if isOrgOwner(orgId);
      }
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create: if request.resource.data.createdBy == request.auth.uid
        && isPoster(request.resource.data.orgId);
      allow update, delete: if signedIn()
        && (
          resource.data.createdBy == request.auth.uid
          || isOrgOwner(resource.data.orgId)
        );
    }

    match /subscriptions/{subscriptionId} {
      // Missing docs must be readable, or "am I subscribed?" throws
      // Missing or insufficient permissions.
      allow get: if signedIn()
        && subscriptionId.matches('^' + request.auth.uid + '_.*');
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if canVolunteer()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == subscriptionId
        && orgData(request.resource.data.orgId).ownerId != request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
